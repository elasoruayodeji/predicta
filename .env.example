# PREDICTA Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────────────────
# Investo Data API (NGX market data)
# ─────────────────────────────────────────────────────────────
# Get your key at: https://investo.ng/developers/keys
# Free tier: 1,000 requests/day for evaluation and personal projects.
# The key is used ONLY by the Node.js proxy server (server/index.js).
# It is NEVER exposed to the browser or included in the built assets.
INVESTO_API_KEY=inv_YOUR_KEY_HERE

# ─────────────────────────────────────────────────────────────
# Server configuration (optional)
# ─────────────────────────────────────────────────────────────
# Port the proxy server listens on. Default: 3001
# PORT=3001
